# Required for Gemini text generation
GEMINI_API_KEY=
HF_TOKEN=
OPENROUTER_API_KEY=

# Optional model overrides. The application automatically falls back when a model
# returns an availability/quota/server error.
GEMINI_OUTLINE_MODEL=gemini-3.6-flash
GEMINI_STORY_MODEL=gemini-3.1-pro-preview

OPENROUTER_TEXT_MODEL=openrouter/free

# Hugging Face remote image generation
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
IMAGE_BACKEND=hf

# Gemini resilience settings
GEMINI_RETRIES_PER_MODEL="2"
GEMINI_RETRY_BACKOFF="1.5"
OPENAI_RETRIES="1"
